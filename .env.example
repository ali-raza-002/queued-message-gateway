# Optional. Copy to .env next to docker-compose.yml to override the stack's
# defaults; Compose reads it for ${VAR} substitution. Settings for running the
# API on the host live in backend/.env.example instead.

# Local-only defaults, matching docker-compose.yml. Change them before the
# database port is reachable by anyone else.
POSTGRES_USER=aila
POSTGRES_PASSWORD=aila
POSTGRES_DB=aila
LOG_LEVEL=INFO

# echo | simulated | openai
REPLY_PROVIDER=simulated
REPLY_MIN_DELAY_SECONDS=5
REPLY_MAX_DELAY_SECONDS=60
REPLY_FAIL_RATE=0.2

# Required only when REPLY_PROVIDER=openai.
OPENAI_API_KEY=
