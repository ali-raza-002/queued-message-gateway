# Copy to .env and edit. Nothing here is required to run the test-suite.

# --- storage ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://aila:aila@db:5432/aila
AUTO_CREATE_SCHEMA=true

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- delivery loop ---------------------------------------------------------
CONCURRENCY=8
CLAIM_BATCH=10
POLL_INTERVAL_SECONDS=1.0
MAX_ATTEMPTS=3
LEASE_SECONDS=300
REAP_INTERVAL_SECONDS=5.0
SHUTDOWN_GRACE_SECONDS=20
STRICT_CONVERSATION_ORDER=true

# --- retry backoff ---------------------------------------------------------
BACKOFF_BASE_SECONDS=2
BACKOFF_FACTOR=2
BACKOFF_MAX_SECONDS=120
BACKOFF_JITTER=0.25

# --- reply provider --------------------------------------------------------
# echo      = deterministic local fake, no credentials, no latency
# simulated = the assignment's random delay + failure rate, wrapping the above
# openai    = a real model, requires OPENAI_API_KEY
REPLY_PROVIDER=simulated
REPLY_MIN_DELAY_SECONDS=5
REPLY_MAX_DELAY_SECONDS=240
REPLY_FAIL_RATE=0.2
# Set to make delays and failures reproducible.
# REPLY_SEED=1

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
